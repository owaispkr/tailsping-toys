---
import type { Category, Publisher } from '../types/game';
import Button from './Button.astro';

interface Props {
    /** Categories available in the current game catalog. */
    categories: Category[];
    /** Publishers available in the current game catalog. */
    publishers: Publisher[];
    /** Number of games shown before filters are applied. */
    totalGames: number;
}

const { categories, publishers, totalGames } = Astro.props;
---

<section
    class="mb-8 rounded-xl border border-slate-700 bg-slate-800/60 p-5 shadow-lg"
    aria-labelledby="game-filters-heading"
    data-testid="game-filters"
>
    <div class="mb-4 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <h2 id="game-filters-heading" class="text-xl font-semibold text-slate-100">
                Filter games
            </h2>
            <p class="text-sm text-slate-400">Choose any categories and one publisher.</p>
        </div>
        <p
            class="text-sm font-medium text-blue-300"
            role="status"
            aria-live="polite"
            data-testid="filter-results-status"
        >
            {totalGames} {totalGames === 1 ? 'game' : 'games'} shown
        </p>
    </div>

    <form id="game-filters-form" class="grid gap-5 lg:grid-cols-[1fr_18rem_auto] lg:items-end">
        <fieldset>
            <legend class="mb-2 text-sm font-medium text-slate-200">Categories</legend>
            <div class="flex flex-wrap gap-3">
                {categories.map((category) => (
                    <label class="inline-flex cursor-pointer items-center gap-2 rounded-lg border border-slate-600 bg-slate-900/60 px-3 py-2 text-sm text-slate-200 transition-colors hover:border-blue-500">
                        <input
                            type="checkbox"
                            name="category"
                            value={category.id}
                            class="h-4 w-4 rounded border-slate-500 bg-slate-800 text-blue-600 focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 focus:ring-offset-slate-900"
                            data-testid={`category-filter-${category.id}`}
                        />
                        {category.name}
                    </label>
                ))}
            </div>
        </fieldset>

        <label class="block text-sm font-medium text-slate-200">
            Publisher
            <select
                name="publisher"
                class="mt-2 block w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:border-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                data-testid="publisher-filter"
            >
                <option value="">All publishers</option>
                {publishers.map((publisher) => (
                    <option value={publisher.id}>{publisher.name}</option>
                ))}
            </select>
        </label>

        <Button type="reset" size="sm" data-testid="clear-filters">
            Clear filters
        </Button>
    </form>
</section>

<script>
    const form = document.querySelector<HTMLFormElement>('#game-filters-form');
    const publisherSelect = form?.querySelector<HTMLSelectElement>('select[name="publisher"]');
    const cards = document.querySelectorAll<HTMLElement>('[data-testid="game-card"]');
    const gamesGrid = document.querySelector<HTMLElement>('[data-testid="games-grid"]');
    const emptyState = document.querySelector<HTMLElement>('[data-testid="filtered-empty-state"]');
    const status = document.querySelector<HTMLElement>('[data-testid="filter-results-status"]');

    function applyFilters(): void {
        if (!form || !publisherSelect || !gamesGrid || !emptyState || !status) {
            return;
        }

        const selectedCategories = new Set(
            Array.from(form.querySelectorAll<HTMLInputElement>('input[name="category"]:checked'))
                .map((input) => input.value),
        );
        const publisherId = publisherSelect.value;
        let visibleCount = 0;

        cards.forEach((card) => {
            const matchesCategory = selectedCategories.size === 0
                || selectedCategories.has(card.dataset.categoryId ?? '');
            const matchesPublisher = publisherId === ''
                || card.dataset.publisherId === publisherId;
            const isVisible = matchesCategory && matchesPublisher;

            card.hidden = !isVisible;
            if (isVisible) {
                visibleCount += 1;
            }
        });

        gamesGrid.hidden = visibleCount === 0;
        emptyState.hidden = visibleCount !== 0;
        status.textContent = `${visibleCount} ${visibleCount === 1 ? 'game' : 'games'} shown`;
    }

    form?.addEventListener('input', applyFilters);
    form?.addEventListener('reset', () => window.setTimeout(applyFilters));
</script>
